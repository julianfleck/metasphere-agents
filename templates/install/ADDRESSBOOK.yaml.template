# ~/.metasphere/ADDRESSBOOK.yaml — instance contact directory.
#
# Single source of truth for cross-channel contact handles
# (Telegram chat ids, plus future: email, Slack ids, etc.).
# Lives at ~/.metasphere/ADDRESSBOOK.yaml — instance state, never
# committed to a repo.
#
# This file is OPTIONAL. Stranger installs without it can still send
# Telegram messages by passing --chat-id explicitly. The addressbook
# only matters when you want named-recipient shortcuts:
#
#     metasphere telegram send "@operator" "hello"
#
# Schema (uncomment + fill in):
#
# contacts:                       # name -> outbound handle(s)
#   operator:
#     telegram: <chat_id>
#   teammate:
#     telegram: <chat_id>
#   # Add new contacts here. Names are case-insensitive at lookup
#   # time. Each contact may carry multiple method handles.
#
# surfaces:                       # PER-SURFACE inbound reverse maps (handle -> name)
#   slack:                        #   keyed by surface_type, or per-bot: slack-<instance>
#     U0EXAMPLE001: operator      #   slack user id -> friendly name (placeholder)
#   # `surfaces` is SEPARATE from `contacts`: a slack uid is its own
#   # standalone contact (no unified identity / email-join). Used to render
#   # a friendly sender on inbound. Populate in bulk with:
#   #     metasphere addressbook sync-slack   (requires the users:read bot scope)
#   # On missing_scope / unmapped uid, inbound falls back to the raw uid.
#
# NOTE: this schema is additively extensible — a future top-level `access:`
# block (owners + per-agent allow-lists keyed by the same surface:uid keys)
# can be added without reworking `contacts` / `surfaces`.

contacts: {}
